---
/**
 * Icon-only "ask an AI about SpaceBay" row for the home page. The assistant's
 * name shows as a tooltip on hover and focus and is the accessible name. The
 * last chip copies the prompt, for any other assistant (src/scripts/copy-prompt.ts).
 */
import { ASSISTANTS, homePrompt } from "../lib/assistants";

const prompt = homePrompt();
---

<div class="ask-ai">
  <span class="ask-ai-label">Ask AI about SpaceBay</span>
  <ul class="ask-ai-list">
    {
      ASSISTANTS.map((a) => (
        <li>
          <a
            class="ask-ai-chip"
            href={a.href(prompt)}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ask ${a.name}`}
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d={a.icon} />
            </svg>
            <span class="ask-ai-tip" data-tip data-idle={a.name} aria-hidden="true">
              {a.name}
            </span>
          </a>
        </li>
      ))
    }
    <li>
      <button class="ask-ai-chip" type="button" data-copy-prompt={prompt} aria-label="Copy the prompt">
        <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M13.469 2.5c.63 0 1.15.48 1.212 1.094l.007.125-.001 1.593h1.407c.73 0 1.331.558 1.4 1.271l.006.136v9.375c0 .776-.63 1.406-1.406 1.406H6.719c-.777 0-1.407-.63-1.407-1.406v-1.407H3.719c-.631 0-1.15-.48-1.213-1.094L2.5 13.47v-9.75c0-.631.48-1.15 1.094-1.213L3.72 2.5h9.75zm2.625 3.75H6.719a.469.469 0 00-.469.469v9.375c0 .259.21.468.469.468h9.375c.259 0 .468-.21.468-.468V6.719a.469.469 0 00-.468-.469zm-2.625-2.813h-9.75a.281.281 0 00-.274.217l-.007.065v9.75c0 .133.092.244.216.274l.065.007 1.593-.001v-7.03c0-.731.558-1.332 1.271-1.4l.136-.006 7.031-.001V3.719a.281.281 0 00-.217-.274l-.064-.007z" />
        </svg>
        <span class="ask-ai-tip" data-tip data-idle="Copy prompt" aria-hidden="true">Copy prompt</span>
      </button>
    </li>
  </ul>
  <span class="ask-ai-sr" role="status" data-ai-status></span>
</div>

<style>
  .ask-ai {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    text-align: center;
    margin: 0 0 2rem;
  }
  /* Starlight spaces markdown siblings apart; inside this row only the gap spaces them. */
  .ask-ai > * {
    margin: 0;
  }
  .ask-ai-label {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    line-height: 1.2;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--sl-color-gray-3);
  }
  .ask-ai-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ask-ai-list li {
    margin: 0;
    padding: 0;
  }
  .ask-ai-chip {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg);
    color: var(--sl-color-gray-2);
    text-decoration: none;
    margin: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }
  .ask-ai-chip:hover,
  .ask-ai-chip:focus-visible {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .ask-ai-chip:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
  .ask-ai-tip {
    position: absolute;
    bottom: 100%;
    left: 50%;
    z-index: 10;
    margin-bottom: 0.4rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    border: 1px solid var(--sl-color-gray-5);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translateX(-50%);
    transition: opacity 0.15s;
  }
  .ask-ai-chip:hover .ask-ai-tip,
  .ask-ai-chip:focus-visible .ask-ai-tip {
    opacity: 1;
  }
  .ask-ai-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  import "../scripts/copy-prompt";
</script>

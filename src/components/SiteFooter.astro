---
import ThemeToggle from "./ThemeToggle.astro";
import iconSvg from "../assets/spacebay-icon.svg";
import { EXTERNAL_LINKS, PAGE_LINKS } from "../lib/links";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const doc = (slug: string) => `${PAGE_LINKS.home}${slug}/`;

const columns = [
  {
    title: "Learn",
    links: [
      { label: "Introduction", href: doc("getting-started/introduction") },
      { label: "Installation", href: doc("getting-started/installation") },
      { label: "Setup wizard", href: doc("getting-started/setup-wizard") },
      { label: "FAQ", href: doc("others/faq") },
      { label: "Troubleshooting", href: doc("others/troubleshooting") },
    ],
  },
  {
    title: "Developers",
    links: [
      { label: "Hooks and filters", href: doc("developers/hooks-and-filters") },
      { label: "REST API", href: doc("developers/rest-api") },
      { label: "Template overrides", href: doc("developers/template-overrides") },
      { label: "WP-CLI", href: doc("developers/wp-cli") },
    ],
  },
  {
    title: "SpaceBay",
    links: [
      { label: "SpaceBay Pro", href: EXTERNAL_LINKS.spacebayPro },
      { label: "Pro features", href: doc("pro/overview") },
      { label: "Changelog", href: doc("others/changelog") },
      { label: "WordPress.org", href: EXTERNAL_LINKS.wordpressPlugin },
    ],
  },
];
---

<div class="sb-footer">
  <div class="sb-footer-top">
    <div class="sb-footer-brand">
      <a href={PAGE_LINKS.home} class="sb-footer-name">
        <img src={iconSvg.src} alt="" width="28" height="28" />
        <span translate="no">SpaceBay</span>
      </a>
      <p>Build a community, activity feed, group chat and events on your own WordPress site.</p>
      <a href={EXTERNAL_LINKS.spacebayPro} class="sb-footer-cta">Get SpaceBay Pro</a>
    </div>
    <nav class="sb-footer-cols" aria-label="Footer">
      {
        columns.map((col) => (
          <div>
            <h2>{col.title}</h2>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="sb-footer-bottom">
    <a href={EXTERNAL_LINKS.wpAnchorBay} class="sb-footer-by" aria-label="WPAnchorBay">
      <span>Built by</span>
      <img data-no-border class="logo-light" src={`${base}assets/wpanchorbay-footer-logo.svg`} alt="WPAnchorBay" width="619" height="120" />
      <img data-no-border class="logo-dark" src={`${base}assets/wpanchorbay-footer-logo-dark.svg`} alt="" width="619" height="120" />
    </a>
    <a href="mailto:support@wpanchorbay.com" class="sb-footer-mail">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect width="20" height="16" x="2" y="4" rx="2"></rect>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
      </svg>
      support@wpanchorbay.com
    </a>
    <div class="sb-footer-theme"><ThemeToggle /></div>
    <p class="sb-footer-copy">&copy; {new Date().getFullYear()} WPAnchorBay. All rights reserved.</p>
  </div>
</div>

<style>
  .sb-footer {
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--sl-color-hairline);
    display: grid;
    gap: 2rem;
  }
  .sb-footer-top {
    display: grid;
    gap: 2.25rem;
  }
  @media (min-width: 50rem) {
    .sb-footer-top {
      grid-template-columns: minmax(14rem, 18rem) 1fr;
      gap: 3rem;
    }
  }
  .sb-footer-brand {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    align-content: start;
  }
  .sb-footer-name {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--sl-text-h4);
    font-weight: 700;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  :root[data-theme="light"] .sb-footer-name {
    color: #10231a;
  }
  .sb-footer-brand p {
    margin: 0;
    max-width: 22rem;
    font-size: var(--sl-text-sm);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }
  .sb-footer-cta {
    display: inline-flex;
    padding: 0.5rem 1.1rem;
    border-radius: 9999px;
    background: #3f22ff;
    border: 1px solid #3f22ff;
    color: #fff;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s ease, box-shadow 0.2s ease;
  }
  .sb-footer-cta:hover {
    background: #3319d6;
    border-color: #3319d6;
    box-shadow: 0 4px 14px color-mix(in srgb, #3f22ff 38%, transparent);
  }
  :root[data-theme="dark"] .sb-footer-cta {
    background: #6a52ff;
    border-color: #6a52ff;
  }
  :root[data-theme="dark"] .sb-footer-cta:hover {
    background: #4a30e0;
  }
  .sb-footer-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 1.75rem 1.5rem;
  }
  .sb-footer-cols h2 {
    margin: 0 0 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
    border: 0;
  }
  .sb-footer-cols ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .sb-footer-cols li {
    margin: 0;
  }
  .sb-footer-cols a {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .sb-footer-cols a:hover,
  .sb-footer-cols a:focus-visible {
    color: var(--sl-color-text-accent);
  }
  .sb-footer-bottom {
    display: grid;
    grid-template-columns: 1fr;
    justify-items: center;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 0 0.5rem;
    border-top: 1px solid var(--sl-color-hairline-light);
  }
  @media (min-width: 50rem) {
    .sb-footer-bottom {
      grid-template-columns: 1fr auto 1fr;
    }
    .sb-footer-by {
      justify-self: start;
    }
    .sb-footer-theme {
      justify-self: end;
    }
  }
  .sb-footer-mail {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.95rem;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--sl-color-gray-4) 55%, transparent);
    background: color-mix(in srgb, var(--sl-color-accent) 7%, transparent);
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .sb-footer-mail:hover,
  .sb-footer-mail:focus-visible {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: #fff;
  }
  .sb-footer-by {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  .sb-footer-by img {
    width: 7.5rem;
    height: auto;
    display: block;
  }
  .logo-dark {
    display: none !important;
  }
  :root[data-theme="dark"] .logo-light {
    display: none !important;
  }
  :root[data-theme="dark"] .logo-dark {
    display: block !important;
  }
  .sb-footer-copy {
    grid-column: 1 / -1;
    margin: 0;
    text-align: center;
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
  }
</style>

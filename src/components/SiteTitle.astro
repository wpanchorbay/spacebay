---
import iconSvg from "../assets/spacebay-icon.svg";
const { siteTitleHref } = Astro.locals.starlightRoute;
const iconUrl = iconSvg.src;
---

<a href={siteTitleHref} class="site-title sl-flex">
	<img class="spacebay-navbar-logo" src={iconUrl} alt="" width="32" height="32" />
	<span class="site-name" translate="no">SpaceBay</span>
	<span class="docs-badge">Docs</span>
</a>

<style>
	@layer starlight.core {
		.site-title {
			align-items: center;
			gap: var(--sl-nav-gap);
			font-size: var(--sl-text-h4);
			font-weight: 600;
			color: var(--sl-color-text-accent);
			text-decoration: none;
			white-space: nowrap;
			min-width: 0;
		}

		.site-title:hover,
		.site-title:focus-visible {
			text-decoration: none;
		}

		.spacebay-navbar-logo {
			display: block;
			flex: 0 0 auto;
			height: 32px;
			width: 32px;
			object-fit: contain;
		}

		.site-name {
			font-weight: 700;
			color: var(--sl-color-white);
		}

		:root[data-theme="light"] .site-name {
			color: #10231a;
		}

		.sr-only {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}

		.docs-badge {
			display: inline-block;
			padding: 0.18rem 0.45rem;
			font-size: 0.7rem;
			font-weight: 600;
			line-height: 1;
			border-radius: 0.25rem;
			background-color: var(--sl-color-accent);
			color: #fff;
			border: 1px solid var(--sl-color-accent);
			margin-left: 0.5rem;
			vertical-align: middle;
			text-transform: uppercase;
			letter-spacing: 0.05em;
		}
	}
</style>

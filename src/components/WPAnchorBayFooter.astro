---
import ThemeToggle from "./ThemeToggle.astro";
import { EXTERNAL_LINKS } from "../lib/links";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<footer class="license-footer">
    <div class="license-footer-inner">
        <div class="license-footer-brand">
            <p class="license-footer-kicker">Brought to you by</p>
            <a href={EXTERNAL_LINKS.wpAnchorBay} class="license-footer-logo">
                <img data-no-border class="wpanchorbay-footer-logo logo-light" src={`${base}assets/wpanchorbay-footer-logo.svg`} alt="WPAnchorBay" width="619" height="120" />
                <img data-no-border class="wpanchorbay-footer-logo logo-dark" src={`${base}assets/wpanchorbay-footer-logo-dark.svg`} alt="" width="619" height="120" />
            </a>
            <p class="license-footer-tagline">
                Plugins for WordPress, built by WPAnchorBay.
            </p>
        </div>

        <div class="license-footer-meta">
            <a
                href="mailto:support@wpanchorbay.com"
                class="license-footer-link"
            >
                support@wpanchorbay.com
            </a>
            <ThemeToggle />
        </div>

        <p class="license-footer-copyright">
            &copy; {new Date().getFullYear()} WPAnchorBay. All rights reserved.
        </p>
    </div>
</footer>

<style>
    .wpanchorbay-footer-logo {
        width: 100%;
        max-width: 260px;
        height: auto;
        display: block;
    }

    .logo-dark {
        display: none;
    }

    :root[data-theme="dark"] .logo-light {
        display: none;
    }

    :root[data-theme="dark"] .logo-dark {
        display: block;
    }
</style>
